# Configurações do Ambiente
ENVIRONMENT=development
DEBUG=True

# Diretório de Dados
DATA_DIR=D:\NatFranca

# Database
DATABASE_URL=sqlite:///D:\NatFranca\database\comex.db

# Alembic na startup (Render/Postgres): timeout do `alembic upgrade head` em segundos (30–900; padrão 300).
# ALEMBIC_UPGRADE_TIMEOUT_SECONDS=300
# Depois que o banco já estiver em `head`, pode pular migrations em todo deploy para subir mais rápido:
# SKIP_ALEMBIC_ON_STARTUP=1

# API Comex Stat (se disponível)
COMEX_STAT_API_URL=http://comexstat.mdic.gov.br/api
COMEX_STAT_API_KEY=

# Configurações de Coleta
UPDATE_INTERVAL_HOURS=24
MONTHS_TO_FETCH=3
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=5

# Logging
LOG_LEVEL=INFO
LOG_DIR=D:\NatFranca\logs

# BigQuery — dashboard /api/comex-dashboard (tabela empresas NCM por UF)
# Formato: projeto.dataset.tabela (sem backticks). Padrão: liquid-receiver-483923-n6.Projeto_Comex.empresas_ncm_import_export_uf
# COMEX_BQ_TABLE_EMPRESAS_NCM=liquid-receiver-483923-n6.Projeto_Comex.empresas_ncm_import_export_uf
#
# Credenciais (Render/local): GOOGLE_APPLICATION_CREDENTIALS_JSON = JSON inteiro da conta de serviço, ou
# GOOGLE_APPLICATION_CREDENTIALS = caminho para o arquivo .json
#
# IAM obrigatório para essa conta (client_email do JSON), no projeto onde está a tabela:
#   - BigQuery Data Viewer no dataset (ou na tabela)
#   - BigQuery Job User no projeto (para executar jobs de consulta)
# Erro 403 "Access Denied" no frontend = falta uma dessas permissões ou COMEX_BQ_TABLE_EMPRESAS_NCM aponta para recurso errado.
